{
  "name": "skynav-sim",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test:unit": "vitest run --reporter=dot",
    "test:int": "vitest run -c vitest.int.config.ts --reporter=dot",
    "lint": "eslint .",
    "typecheck": "nuxi typecheck",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "smoke": "node scripts/smoke.mjs",
    "test:e2e": "node tests/e2e/cockpit.mjs && node tests/e2e/testmode.mjs",
    "data:download": "node scripts/data/download.mjs"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "leaflet": "^1.9.4",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "^0.6.2",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "playwright-core": "^1.65.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
